{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/solve.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/solve", "dest": "/api/solve" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
